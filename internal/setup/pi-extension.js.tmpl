import { spawn } from "node:child_process";
import { Type } from "@sinclair/typebox";

const executable = {{.Executable}};
const connection = {{.Connection}};
const guidance = {{.Guidance}};

function call(tool, args, signal) {
  return new Promise((resolve, reject) => {
    if (signal?.aborted) { reject(new Error("Memory request cancelled")); return; }
    const child = spawn(executable, ["bridge", "--connection", connection], { stdio: ["pipe", "pipe", "pipe"] });
    child.stdout.setEncoding("utf8");
    let output = "";
    let failure = "";
    let size = 0;
    const abort = () => child.kill("SIGTERM");
    const timer = setTimeout(abort, 20000);
    signal?.addEventListener("abort", abort, { once: true });
    child.stdout.on("data", data => {
      size += Buffer.byteLength(data, "utf8");
      if (size > 8 * 1024 * 1024) { failure = "Memory response exceeds its bound"; abort(); return; }
      output += data;
    });
    child.stderr.on("data", () => {});
    child.stdin.on("error", () => {});
    child.on("error", error => { failure = error.message; });
    child.on("close", code => {
      clearTimeout(timer);
      signal?.removeEventListener("abort", abort);
      if (code !== 0 || failure) { reject(new Error(failure || "Memory request failed; run ohya doctor")); return; }
      try {
        const result = JSON.parse(output);
        if (result.isError) { reject(new Error("Memory tool rejected the request")); return; }
        resolve({ content: result.content, details: result.structuredContent });
      } catch (error) { reject(error); }
    });
    const request = JSON.stringify({ tool, arguments: args });
    if (Buffer.byteLength(request, "utf8") > 1024 * 1024) { failure = "Memory request exceeds 1 MiB"; abort(); return; }
    child.stdin.end(request);
  });
}

export default function(pi) {
  pi.registerTool({
    name: "ohya_sql",
    label: "Query agent memory",
    description: guidance + "\nRun one bounded read-only SQL query against ohya (SELECT or read-only PRAGMA; 500 rows, 256 KiB, 5 s). Tables: sessions (scope by repo host/path), workspaces, sources, events (filter duplicate_of IS NULL), events_settled (default recall surface; omits sessions active in last 10 min), events_fts (use snippet(events_fts, 0, '[', ']', '...', 24) and wrap hyphen/punctuation MATCH terms in double quotes), session_token_usage, event_annotations. See the installed ohya skill for recipes, garbage-audit, and ohya sql --json.",
    parameters: Type.Object({ query: Type.String() }),
    async execute(id, args, signal) { return call("sql", args, signal); }
  });
  pi.registerTool({
    name: "ohya_annotate",
    label: "Annotate memory events",
    description: "Atomically apply 1 to 100 upsert/delete annotations in event_annotations without modifying original transcripts. Hub assigns writer_id (never send it). Values are compact JSON up to 64 KiB; use namespace tags, key garbage to nominate sessions for owner ohya purge --marked tags.garbage.",
    parameters: Type.Object({ operations: Type.Array(Type.Object({
      op: Type.Union([Type.Literal("upsert"), Type.Literal("delete")]),
      event_id: Type.Integer(), namespace: Type.String(), key: Type.String(), value: Type.Optional(Type.Any())
    }), { minItems: 1, maxItems: 100 }) }),
    async execute(id, args, signal) { return call("annotate", args, signal); }
  });
}
