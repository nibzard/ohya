/bin/
# stray root-level go build output (make build writes bin/)
/ohya
*.db
*.db-wal
*.db-shm
/tla/.tools/
/tla/states/
/tla/*_TTrace_*.tla
# benchmark runs (make bench-save), profiles, offline analysis outputs
/perf/*
!/perf/README.md
!/perf/hubdata/
!/perf/ftsshare/
!/perf/devratio/
!/perf/zstdbench/
!/perf/recallduration/
!/perf/livehub/
!/perf/observeoverhead/
!/perf/uploadbench/
# local observability state (usage records, snapshots) written by ohya itself
/observe/
# memory-e2e gate output: isolated database, client state, traces
/memory-e2e/
# recall-bench run directories: canary ground truth, traces, reports
/recall-runs/
# looper backlog contract (runtime file owned by the looper tool)
/to-do.json
/to-do.schema.json
/to-do.json.context/
# looper operation resource prefixes (private check-run output)
looper_*/
# regenerated benchmark corpora (docs/performance.md), never committed
/testdata/bench/
# local release candidates
/dist/
