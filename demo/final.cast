[16.278421, "o", "\u001b[2D\u001b[3B\r\u001b[6A\u001b[38;5;231m●\u001b[3G\u001b[39mI found the cause and fixed it. The code and the test\u001b[57Gused\u001b[62Gdifferent\u001b[72Gtime\u001b[77Gzones\u001b[83Gto\u001b[86Gdecide\u001b[93Gwhat\r\u001b[2C\u001b[1B\"today\"\u001b[11Gis.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mCause\r\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;5;153mPromotion.is_active()\u001b[39m used \u001b[38;5;153mdate.today()\u001b[39m. That returns the date in the server's\u001b[84Glocal\u001b[90Gtime\u001b[95Gzone,\r\r\n\u001b[5Gwhich\u001b[11Gis\u001b[14GLos\u001b[18GAngeles\u001b[26Gon\u001b[29GCI.\r\r\n\u001b[3G-\u001b[5GThe\u001b[9Gtest\u001b[14Gbuilt\u001b[20Gits\u001b[24Gdates\u001b[30Gfrom\u001b[35Gthe\u001b[39GUTC\u001b[43Gdate.\r\r\n\r\r\n\u001b[3GLos\u001b[7GAngeles\u001b[15Gis\u001b[18G8\u001b[20Ghours\u001b[26Gbehind\u001b[33GUTC,\u001b[38Gso\u001b[41Gfrom\u001b[46G4\u001b[48GPM\u001b[51Glocal\u001b[57Gtime\u001b[62G(5\u001b[65GPM\u001b[68Gin\u001b[71Gsummer)\u001b[79Gthe\u001b[83GUTC\u001b[87Gdate\u001b[92Gis\u001b[95Gone\r\r\n\u001b[3Gday\u001b[7Gahead.\u001b[14GDuring\u001b[21Gthat\u001b[26Gwindow,\u001b[34Gthe\u001b[38Gtest's\u001b[45G\"expired\u001b[54Gyesterday\"\u001b[65Gdate\u001b[70G(UTC\u001b[75Gdate\u001b[80G−\u001b[82G1)\u001b[85Gis\u001b[88Gtoday's\u001b[96Gdate\r\r\n\u001b[3Gin\u001b[6GLos\u001b[10GAngeles.\u001b[19GThe\u001b[23Gcode\u001b[28Gstill\u001b[34Gsees\u001b[39Gthe\u001b[43Gpromotion\u001b[53Gas\u001b[56Gactive,\u001b[64Gso\u001b[67Gno\u001b[70G\u001b[38;5;153mValueError\u001b[81G\u001b[39mis\u001b[84Graised\u001b[91Gand\u001b[95Gthe\r\r\n\u001b[3Gtest\u001b[8Gfails.\u001b[15GAfter\u001b[21Glocal\u001b[27Gmidnight,\u001b[37Gboth\u001b[42Gdates\u001b[48Gmatch\u001b[54Gagain,\u001b[61Gso\u001b[64Gthe\u001b[68Gtest\u001b[73Gpasses\u001b[80Gin\u001b[83Gthe\u001b[87Gmorning.\r\r\n\r\r\n\u001b[3G\u001b[1mChanges\u001b[22m\r\r\n\r\r\n\u001b[3G-\u001b[5G\u001b[38;5;153m\u001b[1mshopfront/promotions.py\u001b[39m:\u001b[30G\u001b[22mI\u001b[32Gadded\u001b[38Ga\u001b[40G\u001b[38;5;153mutc_today()\u001b[52G\u001b[39mhelper,\u001b[60Gand\u001b[64G\u001b[38;5;153mis_active()\u001b[76G\u001b[39mnow\u001b[80Guses\u001b[85Git.\u001b[89GA\u001b[91Gcomment\u001b[99Gon\r\r\n\u001b[5G\u001b[38;5;153mexpires_on\u001b[16G\u001b[39msays\u001b[21Gthe\u001b[25Gvalue\u001b[31Gis\u001b[34Ga\u001b[36GUTC\u001b[40Gdate\u001b[45Gand\u001b[49Gthe\u001b[53Gpromotion\u001b[63Gstays\u001b[69Gactive\u001b[76Gthrough\u001b[84Gthe\u001b[88Gend\u001b[92Gof\u001b[95Gthat\r\r\n\u001b[5Gday\u001b[9Gin\u001b[12GUTC.\r\r\n\u001b[3G-\u001b[5G\u001b[38;5;153m\u001b[1mtests/test_promotions.py\u001b[39m:\u001b[31G\u001b[22mThe\u001b[35Gtests\u001b[41Gnow\u001b[45Guse\u001b[49Gthe\u001b[53G\u001b[38;5;153mutc_today()\u001b[65G\u001b[39mhelper\u001b[72Gfrom\u001b[77Gthe\u001b[81Gmodule\u001b[88Ginstead\u001b[96Gof\r\r\n\u001b[5Gtheir\u001b[11Gown\u001b[15Gcopy.\u001b[21GI\u001b[23Gadded\u001b[29Ga\u001b[31Gregression\u001b[42Gtest\u001b[47Gthat\u001b[52Gfixes\u001b[58Gthe\u001b[62Gclock\u001b[68Gat\u001b[71G6\u001b[73GPM\u001b[76GLos\u001b[80GAngeles\u001b[88Gtime\u001b[93G(02:00\r\r\n\u001b[5GUTC\u001b[9Gthe\u001b[13Gnext\u001b[18Gday).\u001b[24GIt\u001b[27Gchecks\u001b[34Gthat\u001b[39Ga\u001b[41Gpromotion\u001b[51Gthat\u001b[56Gexpired\u001b[64Gthe\u001b[68Gprevious\u001b[77GUTC\u001b[81Gday\u001b[85Gis\u001b[88Gno\u001b[91Glonger\r\r\n\u001b[5Gactive.\r\r\n\u001b[3G-\u001b[5G\u001b[38;5;153m\u001b[1mREADME.md\u001b[39m:\u001b[16G\u001b[22mI\u001b[18Gadded\u001b[24Ga\u001b[26Gshort\u001b[32G\"Promotion\u001b[43Gdates\"\u001b[50Gsection\u001b[58Gwith\u001b[63Gthe\u001b[67GUTC\u001b[71Grule,\u001b[77Gso\u001b[80Gfuture\u001b[87Gcode\u001b[92Guses\r\r\n\u001b[5G\u001b[38;5;153mutc_today()\u001b[17G\u001b[39mand\u001b[21Gnot\u001b[25G\u001b[38;5;153mdate.today()\u001b[39m.\r\r\n\r\r\n\u001b[3GAll\u001b[7G3\u001b[9Gtests\u001b[15Gpass\u001b[20Glocally.\u001b[29GI\u001b[31Gcould\u001b[37Gnot\u001b[41Grerun\u001b[47Gthe\u001b[51Gsuite\u001b[57Gwith\u001b[62Ga\u001b[64GLos\u001b[68GAngeles\u001b[76Gevening\u001b[84Gclock\u001b[90Gbecause\r\r\n\u001b[3G\u001b[38;5;153mfaketime\u001b[12G\u001b[39mis\u001b[15Gnot\u001b[19Ginstalled\u001b[29Ghere.\u001b[35GThe\u001b[39Gnew\u001b[43Gregression\u001b[54Gtest\u001b[59Gcovers\u001b[66Gthat\u001b[71Gcase\u001b[76Gby\u001b[79Gsetting\u001b[87Gthe\u001b[91Gdate\r\r\n\u001b[3Gdirectly.\r\r\n\r\r\n\u001b[3GOne\u001b[7Geffect\u001b[14Gon\u001b[17Gthe\u001b[21Gshop:\u001b[27Gpromotions\u001b[38Gnow\u001b[42Gend\u001b[46Gat\u001b[49Gmidnight\u001b[58GUTC,\u001b[63Gwhich\u001b[69Gis\u001b[72G4\u001b[74GPM\u001b[77Gor\u001b[80G5\u001b[82GPM\u001b[85Gin\u001b[88GLos\u001b[92GAngeles.\r\r\n\u001b[3GBefore,\u001b[11Gthey\u001b[16Gended\u001b[22Gat\u001b[25Gmidnight\u001b[34GLos\u001b[38GAngeles\u001b[46Gtime.\u001b[52GCheck\u001b[58Gthat\u001b[63Gthis\u001b[68Gmatches\u001b[76Gwhat\u001b[81Gthe\u001b[85Gpromotions\u001b[96Gteam\r\r\n\u001b[3Gexpects.\r\r\n\r\r\n\u001b[3GI\u001b[5Ghave\u001b[10Gnot\u001b[14Gcommitted\u001b[24Ganything.\r\r\n\r\r\n\u001b[38;5;246m✻\u001b[3GChurned\u001b[11Gfor\u001b[15G26s\u001b[19G·\u001b[21Gdone\u001b[26G10:19\u001b[32GPM\u001b[39m\r\r\n\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n❯ \u001b[7m \u001b[27m\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;147m⏵⏵\u001b[6Gaccept\u001b[13Gedits\u001b[19Gon\u001b[38;5;246m (shift+tab\u001b[33Gto\u001b[36Gc"]
