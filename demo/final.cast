[13.748482, "o", "\u001b[2D\u001b[3B\r\u001b[6A\u001b[38;5;246m \u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(\u001b]8;id=1bhczz1;file:///home/agent/code/shopfront/tests/test_promotions.py\u0007tests/test_promotions.py\u001b]8;;\u0007)\u001b[K\r\u001b[2B\u001b[38;5;174m✢\u001b[39m \u001b[38;5;174mTr\u001b[38;5;216mans\u001b[38;5;174mmogrifying… \u001b[38;5;246m(12s · ↓\u001b[39m \u001b[38;5;246m869 tokens)\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[2B\u001b[38;5;246m❯ \u001b[39m\u001b[7m \u001b[27m\u001b[K\r\r\n\u001b[38;5;244m────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\r\r\n\u001b[3G\u001b[38;5;147m⏵⏵\u001b[6Gaccept\u001b[13Gedits\u001b[19Gon\u001b[38;5;246m (shift+tab\u001b[33Gto\u001b[36Gcycle)\u001b[43G·\u001b[45Gesc\u001b[49Gto\u001b[52Ginterrupt\u001b[62G·\u001b[64G←\u001b[66Gfor\u001b[70Gagents\u001b[39m\r\r\n\u001b[2C\u001b[3A"]
[13.752186, "o", "\u001b[2D\u001b[3B\r\u001b[8A\u001b[38;5;114m●\r\u001b[1B\u001b[38;5;246m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m11\u001b[15G\u001b[22mlines,\u001b[22Gremoved\u001b[30G\u001b[1m6\u001b[32G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[38;5;167m\u001b[48;5;52m  1 -\u001b[38;5;231mfrom datetime import datetime, timedelta, timezone                                 \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m  1 +\u001b[38;5;197mfrom\u001b[38;5;231m datetime \u001b[38;5;197mimport\u001b[38;5;231m \u001b[48;5;28mdate\u001b[48;5;22m, timedelta                                               \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;5;231m\u001b[2m  2 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B   \u001b[6G\u001b[38;5;231m\u001b[2m  3 \u001b[22m \u001b[38;5;197mimport\u001b[38;5;231m pytest\r\u001b[1B\u001b[39m     \u001b[38;5;231m\u001b[2m  4 \u001b[22m \u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;5;167m\u001b[48;5;52m  5 -\u001b[38;5;231mfrom shopfront.promotions import Promotion, apply                                  \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;77m\u001b[48;5;22m  5 +\u001b[38;5;197mfrom\u001b[38;5;231m shopfront \u001b[38;5;197mimport\u001b[38;5;231m promotions                                                   \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;77m\u001b[48;5;22m  6 +\u001b[38;5;197mfrom\u001b[38;5;231m shopfront.promotions \u001b[38;5;197mimport\u001b[38;5;231m Promotion, apply, utc_today                       \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;231m\u001b[2m \u001b[8G7\u001b[10G\u001b[22m \u001b[39m\r\r\n\u001b[6G\u001b[38;5;231m\u001b[2m \u001b[8G8\u001b[10G\u001b[22m \u001b[39m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m  8 -\u001b[38;5;231mdef utc_today():                                                                   \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m  9 -\u001b[38;5;231m    return datetime.now(timezone.utc).date()                                       \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 10 -\u001b[38;5;231m                                                                                   \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 11 -\u001b[38;5;231m                                                                                   \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;231m\u001b[2m \u001b[8G9\u001b[10G\u001b[22m \u001b[38;5;81mdef\u001b[38;5;231m \u001b[38;5;148mtest_active_code_takes_percent_off\u001b[38;5;231m():\u001b[39m\r\r\n\u001b[6G\u001b[38;5;231m\u001b[2m 10\u001b[10G\u001b[22m \u001b[15Gpromo\u001b[21G=\u001b[23GPromotion(\u001b[38;5;186m\"SPRING10\"\u001b[38;5;231m,\u001b[45G\u001b[38;5;141m10\u001b[38;5;231m,\u001b[49Gexpires_on=utc_today()\u001b[72G+\u001b[74Gtimedelta(days=\u001b[38;5;141m7\u001b[38;5;231m))\u001b[39m\r\r\n\u001b[6G\u001b[38;5;231m\u001b[2m 11\u001b[10G\u001b[22m \u001b[15G\u001b[38;5;197massert\u001b[38;5;231m apply(promo,\u001b[35G\u001b[38;5;141m5000\u001b[38;5;231m)\u001b[41G==\u001b[44G\u001b[38;5;141m4500\u001b[39m\r\r\n\u001b[6G\u001b[38;5;246m...\u001b[39m\r\r\n\u001b[6G\u001b[38;5;231m\u001b[2m 15\u001b[10G\u001b[22m \u001b[15Gpromo\u001b[21G=\u001b[23GPromotion(\u001b[38;5;186m\"SPRING10\"\u001b[38;5;231m,\u001b[45G\u001b[38;5;141m10\u001b[38;5;231m,\u001b[49Gexpires_on=utc_today()\u001b[72G-\u001b[74Gtimedelta(days=\u001b[38;5;141m1\u001b[38;5;231m))\u001b[39m\r\r\n\u001b[6G\u001b[38;5;231m\u001b[2m 16\u001b[10G\u001b[22m \u001b[15G\u001b[38;5;197mwith\u001b[38;5;231m pytest.raises(ValueError):\u001b[39m\r\r\n\u001b[6G\u001b[38;5;231m\u001b[2m 17\u001b[10G\u001b[22m \u001b[19Gapply(promo,\u001b[32G\u001b[38;5;141m5000\u001b[38;5;231m)\u001b[39m\r\r\n\u001b[6G\u001b[38;5;77m\u001b[48;5;22m 18 +\u001b[38;5;231m                                                                                   \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;77m\u001b[48;5;22m 19 +\u001b[38;5;231m                                                                                   \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;77m\u001b[48;5;22m 20 +\u001b[38;5;81mdef\u001b[38;5;231m \u001b[38;5;148mtest_expiry_uses_utc_date_not_local_date\u001b[38;5;231m(\u001b[38;5;208mmonkeypatch\u001b[38;5;231m):                         \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;77m\u001b[48;5;22m 21 +\u001b[38;5;231m    \u001b[38;5;242m# 2026-11-17 18:00 in Los Angeles is 2026-11-18 02:00 UTC.\u001b[38;5;231m                     \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;77m\u001b[48;5;22m 22 +\u001b[38;5;231m    \u001b[38;5;242m# A promotion that expired on 2026-11-17 UTC is no longer active.\u001b[38;5;231m              \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;77m\u001b[48;5;22m 23 +\u001b[38;5;231m    monkeypatch.\u001b[38;5;148msetattr\u001b[38;5;231m(promotions, \u001b[38;5;186m\"utc_today\"\u001b[38;5;231m, \u001b[38;5;197mlambda\u001b[38;5;231m: date(\u001b[38;5;141m2026\u001b[38;5;231m, \u001b[38;5;141m11\u001b[38;5;231m, \u001b[38;5;141m18\u001b[38;5;231m))       \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;77m\u001b[48;5;22m 24 +\u001b[38;5;231m    promo = Promotion(\u001b[38;5;186m\"SPRING10\"\u001b[38;5;231m, \u001b[38;5;141m10\u001b[38;5;231m, expires_on=date(\u001b[38;5;141m2026\u001b[38;5;231m, \u001b[38;5;141m11\u001b[38;5;231m, \u001b[38;5;141m17\u001b[38;5;231m))               \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;77m\u001b[48;5;22m 25 +\u001b[38;5;231m    \u001b[38;5;197massert\u001b[38;5;231m \u001b[38;5;197mnot\u001b[38;5;231m promo.is_active()                                         "]
